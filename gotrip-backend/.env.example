# ==========================================
# Konfigurasi Database PostgreSQL
# ==========================================
# Opsi 1: Menggunakan DSN lengkap
DATABASE_DSN=host=localhost user=postgres password=secret dbname=gotrip_db port=5432 sslmode=disable

# Opsi 2: Menggunakan parameter terpisah (fallback jika DATABASE_DSN kosong)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=gotrip_db
DB_SSLMODE=disable

# ==========================================
# Autentikasi JWT
# ==========================================
JWT_SECRET=your-secret-key-gotrip-change-in-production

# ==========================================
# Integrasi Payment Gateway Midtrans (Snap)
# ==========================================
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_NOTIFICATION_URL=https://your-domain.com/api/payments/webhook
MIDTRANS_PAYMENT_EXPIRY_MINUTES=60

# ==========================================
# Aplikasi
# ==========================================
APP_BASE_URL=http://localhost:8080
