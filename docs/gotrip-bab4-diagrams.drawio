        <mxCell id="erd_users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;PK id : uint&lt;br&gt;name : string&lt;br&gt;email : string unique&lt;br&gt;password : string&lt;br&gt;phone : string&lt;br&gt;nik : string unique&lt;br&gt;role : varchar(20)&lt;br&gt;check_in : bool&lt;br&gt;check_out : bool&lt;br&gt;check_in_at : timestamp nullable&lt;br&gt;check_out_at : timestamp nullable&lt;br&gt;created_at : timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;align=left;verticalAlign=top;spacing=10;fontSize=13" vertex="1" parent="1">
